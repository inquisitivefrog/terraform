# One PostgreSQL cluster run by CloudNativePG, the private-cloud counterpart
# of an Aurora PostgreSQL cluster:
#   - one primary and streaming replicas, required to be in different zones;
#   - quorum synchronous replication (ANY n): a commit is acknowledged only
#     once n standbys have it, so losing the primary's zone loses no
#     committed data; failoverQuorum promotes only a standby known to have
#     every acknowledged commit;
#   - automatic failover: the operator promotes a standby and repoints the
#     -rw service (service discovery is the Kubernetes Service);
#   - TLS always on (operator-managed CA); non-TLS client connections are
#     rejected in pg_hba, as rds.force_ssl does on Aurora;
#   - passwords generated by the operator into Secrets, never in Terraform
#     state; a PodDisruptionBudget keeps node drains from taking out quorum;
#   - every instance scraped by the shared Prometheus (monitoring.tf).

resource "kubernetes_manifest" "cluster" {
  # The operator writes its own settings (wal_level, archive_mode, ...) into
  # spec.postgresql.parameters; without this, every apply fails with
  # "Provider produced inconsistent result" and taints the cluster.
  computed_fields = ["metadata.labels", "metadata.annotations", "spec.postgresql.parameters"]

  manifest = {
    apiVersion = "postgresql.cnpg.io/v1"
    kind       = "Cluster"
    metadata = {
      name      = var.name
      namespace = var.namespace
    }
    spec = merge(var.backup == null ? {} : {
      # The Barman Cloud plugin archives WAL and takes base backups to the
      # ObjectStore (backup.tf). Adding it restarts every instance (a new
      # sidecar), replicas first, then a switchover.
      plugins = [{
        name          = local.barman_plugin
        isWALArchiver = true
        parameters    = { barmanObjectName = kubernetes_manifest.object_store[0].manifest.metadata.name }
      }]
      }, {
      instances             = var.instances
      imageName             = var.image
      primaryUpdateStrategy = "unsupervised"
      # On a new image the replicas update first; then switch over to one of
      # them (seconds of errors) rather than restart the primary in place
      # (the default: no writer until it is back). Runbook 13.
      primaryUpdateMethod  = "switchover"
      enablePDB            = true
      failoverDelay        = var.failover_delay
      smartShutdownTimeout = var.smart_shutdown_timeout

      bootstrap = {
        initdb = {
          database = var.database
          owner    = var.owner
          # Detect corruption instead of replicating it. Off by default before
          # PostgreSQL 18 (on from 18), and pg_upgrade needs old and new to match.
          dataChecksums = true
        }
      }

      postgresql = {
        parameters = var.parameters
        pg_hba = [
          "hostnossl all all 0.0.0.0/0 reject",
          "hostnossl all all ::/0 reject",
        ]
        synchronous = {
          method         = "any"
          number         = var.synchronous_replicas
          dataDurability = "required"
          failoverQuorum = true
        }
      }

      affinity = {
        enablePodAntiAffinity = true
        topologyKey           = "topology.kubernetes.io/zone"
        podAntiAffinityType   = "required"
      }

      storage = {
        size = var.storage_size
      }

      resources = {
        requests = { cpu = var.cpu_request, memory = var.memory }
        limits   = { memory = var.memory }
      }
    })
  }

  wait {
    condition {
      type   = "Ready"
      status = "True"
    }
  }

  timeouts {
    create = var.wait_timeout
    update = var.wait_timeout
  }
}
