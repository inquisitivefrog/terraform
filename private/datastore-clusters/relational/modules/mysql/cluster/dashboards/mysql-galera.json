              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Load: CRUDS and connections",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Statements by type",
      "description": "Create, read, update, delete per second across the cluster (Com_* counters).",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (command) (rate(mysql_global_status_commands_total{namespace=\"$namespace\", pod=~\"$pod\", command=~\"select|insert|update|delete|replace\"}[$__rate_interval]))",
          "legendFormat": "{{command}}",
          "refId": "A"
