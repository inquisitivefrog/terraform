    {
      "type": "timeseries",
      "title": "Connections against the limit",
      "description": "Connected and running threads against max_connections (the operator set 64 for 768 Mi). Connected reaching the limit is runbook 32, connection exhaustion.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mysql_global_status_threads_connected{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} connected",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mysql_global_status_threads_running{namespace=\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} running",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mysql_global_variables_max_connections{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "max_connections",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Refused and failed connections",
      "description": "Aborted connects (bad password, TLS refused) and connection errors by reason (max_connections among them).",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(mysql_global_status_aborted_connects{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} aborted connects",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, error) (rate(mysql_global_status_connection_errors_total{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) > 0",
          "legendFormat": "{{pod}} {{error}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
