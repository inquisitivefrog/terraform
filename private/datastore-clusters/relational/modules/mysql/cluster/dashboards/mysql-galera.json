          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(mysql_global_status_wsrep_received{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} received",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
