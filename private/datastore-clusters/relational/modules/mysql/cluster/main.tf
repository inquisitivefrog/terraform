# One MySQL cluster run by the Percona Operator for MySQL (Percona XtraDB
# Cluster), the private-cloud counterpart of an Aurora MySQL cluster:
#   - Galera: every node has all the data; a transaction commits only after
#     a majority of nodes certify it, so a 3-node cluster keeps writing with
#     one zone down and loses no committed data;
#   - nodes are required to be in different zones (antiAffinityTopologyKey);
#   - HAProxy, one per zone, sends all writes to one node (avoiding
#     multi-writer conflicts) and moves them when that node fails its health
#     check; <name>-haproxy is the writer endpoint, <name>-haproxy-replicas
#     the reader endpoint;
#   - TLS on for clients and between nodes (operator-generated certificates);
#     require_secure_transport rejects unencrypted clients, as on Aurora;
#   - system passwords generated by the operator into <name>-secrets, never
#     in Terraform state; PodDisruptionBudgets allow one node down at a time;
#   - a mysqld_exporter sidecar per node for Prometheus (monitoring.tf);
#   - backups to an S3-compatible store when var.backup is set (below).

resource "kubernetes_manifest" "cluster" {
  manifest = {
    apiVersion = "pxc.percona.com/v1"
    kind       = "PerconaXtraDBCluster"
    metadata = {
      name      = var.name
      namespace = var.namespace
      # Ordered shutdown on delete, then remove the volumes and certificates
      # (dev: the data is throwaway).
      finalizers = [
        "percona.com/delete-pxc-pods-in-order",
        "percona.com/delete-pxc-pvc",
        "percona.com/delete-ssl",
      ]
    }
    spec = merge(var.backup == null ? {} : { backup = local.backup }, {
      crVersion      = var.cr_version
      secretsName    = "${var.name}-secrets"
      updateStrategy = "SmartUpdate"
      upgradeOptions = { apply = "disabled" } # versions are pinned here, not chosen by the operator
      tls            = { enabled = true }

      pxc = {
        size         = var.size
        image        = var.pxc_image
        autoRecovery = true
        configuration = format("%s\n", join("\n", compact([
          "[mysqld]",
          "require_secure_transport=ON",
          # Binlogs kept on each node 7 days, not MySQL's 30: the binlog
          # collector starts a new one every minute (FLUSH BINARY LOGS), and
          # once uploaded the store's copy is the one a restore uses.
          "binlog_expire_logs_seconds=604800",
          var.innodb_buffer_pool_size == null ? "" : "innodb_buffer_pool_size=${var.innodb_buffer_pool_size}",
          # This file is read after the operator's node.cnf and replaces its
          # whole wsrep_provider_options line, so the operator's pc.weight=10
          # is repeated here.
          var.gcache_size == null ? "" : "wsrep_provider_options=\"pc.weight=10;gcache.size=${var.gcache_size}\"",
        ])))
        resources = {
          requests = { cpu = var.cpu_request, memory = var.memory }
          limits   = { memory = var.memory }
        }
        affinity            = { antiAffinityTopologyKey = "topology.kubernetes.io/zone" }
        podDisruptionBudget = { maxUnavailable = 1 }
        sidecars            = [local.exporter_sidecar]
        volumeSpec = {
          persistentVolumeClaim = {
            accessModes = ["ReadWriteOnce"]
            resources   = { requests = { storage = var.storage_size } }
          }
        }
      }

      haproxy = {
        enabled = true
        size    = var.size
        image   = var.haproxy_image
        resources = {
          requests = { cpu = "100m", memory = "128Mi" }
          limits   = { memory = "256Mi" }
        }
        affinity            = { antiAffinityTopologyKey = "topology.kubernetes.io/zone" }
        podDisruptionBudget = { maxUnavailable = 1 }
      }

      proxysql     = { enabled = false }
      logcollector = { enabled = false }
      pmm          = { enabled = false }

      users = [{
        name   = var.app_user
        hosts  = ["%"]
        dbs    = [var.database]
        grants = ["ALL"]
      }]
    })
  }

  wait {
    fields = {
      "status.state" = "ready"
    }
  }

  timeouts {
    create = var.wait_timeout
    update = var.wait_timeout
  }
}

# Backups (when var.backup is set), run by the operator:
#   - full backups: a Job joins Galera as an arbitrator and asks for a full
#     state transfer; a non-writer node donates it with XtraBackup, a
#     physical copy of the data files taken while it keeps serving, and the
#     Job uploads it to the bucket (xbcloud); weekly on a schedule, more on
#     demand (PerconaXtraDBClusterBackup resources, scripts/backup_now.sh);
#   - point-in-time recovery: a binlog collector Deployment uploads every
#     binary log to the same bucket (each minute, or when one fills); a
#     restore is the newest full backup before the target time, plus the
#     binlogs replayed up to it (needs GTIDs, which PXC keeps on).
# See docs/BACKUPS.md.
locals {
  backup = var.backup == null ? null : {
    image = var.backup.image
    # How long a backup Job may run. The operator writes its default (1200 s)
    # into the spec when unset, so Terraform saw a field appear after apply
    # ("Provider produced inconsistent result", 2026-11-02); set it here.
    runningDeadlineSeconds = 1200
    pitr = {
      enabled            = true
      storageName        = "s3"
      timeBetweenUploads = 60
      timeoutSeconds     = 60
      # Each binlog upload holds a 528 MiB buffer: the collector streams to
      # minio-go v7.2.0 with an unknown length and no part size, so it plans
      # parts for a 5 TiB object (operator 1.20.0; BUFFER_SIZE, 75% of this
      # limit, is set but never read). OOMKilled at 256Mi on the seed's
      # 266 MB binlog (2026-11-02), and at 1Gi on small ones (2026-11-03),
      # likely two buffers alive before garbage collection. Upstream:
      # percona-xtradb-cluster-operator issue #2560 (memory, no cause yet).
      # 1.5Gi: room for two buffers plus the process; the request is what it
      # holds between uploads (about one buffer).
      resources = {
        requests = { cpu = "20m", memory = "640Mi" }
        limits   = { memory = "1536Mi" }
      }
    }
    storages = {
      s3 = {
        type = "s3"
        # The backup Job: it receives the donor's stream and uploads it.
        resources = {
          requests = { cpu = "100m", memory = "256Mi" }
          limits   = { memory = "1Gi" }
        }
        s3 = {
          bucket            = var.backup.bucket
          credentialsSecret = var.backup.secret   # AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
          endpointUrl       = var.backup.endpoint # https: the store's certificate is checked
          caBundle          = { name = kubernetes_secret_v1.backup_ca[0].metadata[0].name, key = "ca.crt" }
          region            = "us-east-1" # signing only; the store has no regions
          forcePathStyle    = true        # <endpoint>/<bucket>/..., not <bucket>.<endpoint>
        }
      }
    }
    schedule = [{
      name        = "scheduled"
      schedule    = var.backup.schedule
      storageName = "s3"
      # Count, not age: the operator deletes the oldest scheduled backup
      # beyond this many, from the store too.
      retention = { type = "count", count = var.backup.keep, deleteFromStorage = true }
    }]
  }
}

# The store's CA certificate (public: no key), which the backup Jobs, the
# binlog collector and restores trust for the endpoint
resource "kubernetes_secret_v1" "backup_ca" {
  count = var.backup == null ? 0 : 1

  metadata {
    name      = "${var.name}-backup-ca"
    namespace = var.namespace
    labels    = { "app.kubernetes.io/part-of" = "backups" }
  }
  data = { "ca.crt" = var.backup.ca }
}
