variable "name" {
  description = "Deployment and Service name, e.g. orders-pg"
  type        = string
}

variable "namespace" {
  type = string
}

variable "engine" {
  description = "postgresql or mysql: picks the app's SQL and connection settings"
  type        = string

  validation {
    condition     = contains(["postgresql", "mysql"], var.engine)
    error_message = "engine must be postgresql or mysql."
  }
}

variable "image" {
  description = "orders image, loaded into the kind nodes by scripts/build_app.sh"
  type        = string
}

variable "writer_host" {
  description = "Writer endpoint, host:port"
  type        = string
}

variable "reader_host" {
  description = "Reader endpoint, host:port"
  type        = string
}

variable "database" {
  type = string
}

variable "user" {
  description = "Database user: the application's own, never a superuser or the operator's system users"
  type        = string
}

variable "password_secret" {
  description = "Secret and key holding the user's password (generated by the operator)"
  type        = object({ name = string, key = string })
}

variable "ca_secret" {
  description = "Secret holding the cluster's CA certificate as ca.crt"
  type        = string
}

variable "replicas" {
  description = "Pods, spread across zones"
  type        = number
  default     = 2
}

variable "memory" {
  description = "Memory request and limit per pod (the JVM heap is 60% of it)"
  type        = string
  default     = "512Mi"
}
