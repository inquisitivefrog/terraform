{
  "uid": "relational-orders-load",
  "title": "Relational / Orders load (k6 and app)",
  "description": "The orders example app under its k6 CRUDS load: what users see (per-operation latency, errors, lost writes) and what the app sees (endpoints, connection pools, retries).",
  "tags": [
    "relational",
    "k6",
    "orders"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "engine",
        "type": "custom",
        "query": "postgresql,mysql",
        "current": {
          "text": "postgresql",
          "value": "postgresql"
        },
        "options": [
          {
            "text": "postgresql",
            "value": "postgresql",
            "selected": true
          },
          {
            "text": "mysql",
            "value": "mysql",
            "selected": false
          }
        ]
      },
      {
        "name": "testid",
        "label": "run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(k6_vus{engine=\"$engine\"}, testid)",
          "refId": "testid"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "User view: the k6 load (the SLO)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Acknowledged writes lost",
      "description": "Orders the app answered 201 for, never deleted, later 404. Must be 0 (runbook 24).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(k6_orders_lost_total{testid=~\"$testid\", engine=\"$engine\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "Errors",
      "description": "Share of requests in the range that failed (non-2xx or no answer). SLO: under 1% per operation.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(k6_http_reqs_total{testid=~\"$testid\", engine=\"$engine\", expected_response=\"false\"}[$__range])) / sum(increase(k6_http_reqs_total{testid=~\"$testid\", engine=\"$engine\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "Dropped iterations",
      "description": "Requests k6 could not start on time: every virtual user was busy waiting. Rises when the app slows.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(k6_dropped_iterations_total{testid=~\"$testid\", engine=\"$engine\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "Virtual users busy",
      "description": "k6 adds users (up to 200) to hold the request rate as latency rises.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{testid=~\"$testid\", engine=\"$engine\"})",
          "instant": true
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by operation",
      "description": "SLO p95: read 100 ms, create/update/delete 200 ms, search 300 ms. The planted missing index shows as search climbing while read stays flat.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (op) (k6_http_req_duration_p95{testid=~\"$testid\", engine=\"$engine\"})",
          "legendFormat": "{{op}}"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "p99 latency by operation",
      "description": "The tail: switchovers, garbage collection and lock waits show here first.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (op) (k6_http_req_duration_p99{testid=~\"$testid\", engine=\"$engine\"})",
          "legendFormat": "{{op}}"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by operation",
      "description": "Open model: k6 holds the total rate whatever the latency, so a slowdown shows as latency and dropped iterations, not less load.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(k6_http_reqs_total{testid=~\"$testid\", engine=\"$engine\"}[$__rate_interval]))",
          "legendFormat": "{{op}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate by operation",
      "description": "Failed share of each operation's requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(k6_http_reqs_total{testid=~\"$testid\", engine=\"$engine\", expected_response=\"false\"}[$__rate_interval])) / sum by (op) (rate(k6_http_reqs_total{testid=~\"$testid\", engine=\"$engine\"}[$__rate_interval]))",
          "legendFormat": "{{op}}"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "row",
      "title": "The app: orders-$engine",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Server p95 by endpoint",
      "description": "Time inside the app, from its own histogram: compare with k6's view to separate app and network time.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{namespace=\"relational\", engine=\"$engine\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Responses by status",
      "description": "503 = the database was unavailable after retries; 404 on reads would be lost writes.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"relational\", engine=\"$engine\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Connection pools",
      "description": "Writer and reader pools, all pods (10 connections each per pod). Pending > 0: requests waiting for a connection (runbook 32).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (hikaricp_connections_active{namespace=\"relational\", engine=\"$engine\"})",
          "legendFormat": "{{pool}} active"
        },
        {
          "refId": "B",
          "expr": "sum by (pool) (hikaricp_connections_pending{namespace=\"relational\", engine=\"$engine\"})",
          "legendFormat": "{{pool}} pending"
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Database retries by operation",
      "description": "Calls retried after a transient failure: lost connection, failover, deadlock, Galera certification conflict.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(orders_db_retries_total{namespace=\"relational\", engine=\"$engine\"}[$__rate_interval]))",
          "legendFormat": "{{op}}"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "JVM heap by pod",
      "description": "Heap is capped at 60% of the container's memory limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (jvm_memory_used_bytes{namespace=\"relational\", engine=\"$engine\", area=\"heap\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    }
  ]
}