# Shared monitoring for every datastore category: Prometheus (via the
# Prometheus Operator), Grafana, Alertmanager, node and kube-state metrics.
#
# - Prometheus picks up ServiceMonitors, PodMonitors and PrometheusRules from
#   every namespace, so a category ships its own scrape config and alerts.
# - Grafana loads dashboards from ConfigMaps labelled grafana_dashboard=1 in
#   any namespace, so a category ships its own dashboards too.
# - The remote-write receiver is on so k6 load tests push their results
#   (latency, errors per CRUD operation) into the same Prometheus.
# - Grafana's admin password is generated by the chart into Secret
#   monitoring/kube-prometheus-stack-grafana, never in Terraform state.
# - kind runs etcd, the scheduler, the controller manager and kube-proxy
#   bound to localhost, so scraping them only produces false alerts: off.
# - Every component has a memory request and limit. Without them a pod is
#   BestEffort: unbounded on a node it shares with a database, invisible to
#   the scheduler's arithmetic, and the first evicted.
resource "helm_release" "kube_prometheus_stack" {
  name             = "kube-prometheus-stack"
  repository       = "https://prometheus-community.github.io/helm-charts"
  chart            = "kube-prometheus-stack"
  version          = var.chart_version
  namespace        = "monitoring"
  create_namespace = true
  wait             = true
  timeout          = 600

  values = [yamlencode({
    kubeEtcd              = { enabled = false }
    kubeScheduler         = { enabled = false }
    kubeControllerManager = { enabled = false }
    kubeProxy             = { enabled = false }

    prometheusOperator = {
      resources = {
        requests = { cpu = "20m", memory = "64Mi" }
        limits   = { memory = "256Mi" }
      }
      # The config-reloader sidecar in the Prometheus and Alertmanager pods.
      prometheusConfigReloader = {
        resources = {
          requests = { cpu = "10m", memory = "32Mi" }
          limits   = { memory = "64Mi" }
        }
      }
    }
    kube-state-metrics = {
      resources = {
        requests = { cpu = "20m", memory = "64Mi" }
        limits   = { memory = "256Mi" }
      }
    }
    prometheus-node-exporter = {
      resources = {
        requests = { cpu = "10m", memory = "32Mi" }
        limits   = { memory = "96Mi" }
      }
    }

    prometheus = {
      prometheusSpec = {
        retention                               = var.retention
        enableRemoteWriteReceiver               = true
        serviceMonitorSelectorNilUsesHelmValues = false
        podMonitorSelectorNilUsesHelmValues     = false
        ruleSelectorNilUsesHelmValues           = false
        probeSelectorNilUsesHelmValues          = false
        resources = {
          requests = { cpu = "200m", memory = "768Mi" }
          limits   = { memory = "1536Mi" }
        }
      }
    }

    # Requests sized from measured working sets (2026-10-26: Grafana 532 MiB,
    # each sidecar about 80 MiB) so none runs above its request. GOMEMLIMIT
    # makes Go collect garbage before Grafana reaches its limit (it reached
    # 708 MiB unbounded).
    grafana = {
      resources = {
        requests = { cpu = "50m", memory = "640Mi" }
        limits   = { memory = "1Gi" }
      }
      env = { GOMEMLIMIT = "900MiB" }
      sidecar = {
        resources = {
          requests = { cpu = "10m", memory = "128Mi" }
          limits   = { memory = "256Mi" }
        }
        dashboards = {
          enabled         = true
          label           = "grafana_dashboard"
          labelValue      = "1"
          searchNamespace = "ALL"
        }
      }
    }

    alertmanager = {
      alertmanagerSpec = {
        resources = {
          requests = { cpu = "20m", memory = "64Mi" }
          limits   = { memory = "128Mi" }
        }
      }
    }
  })]
}
