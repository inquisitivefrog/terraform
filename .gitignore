# Terraform state files
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.plan
*plan

# Terraform variables with sensitive data
terraform.tfvars
*.tfvars.json

# AWS credentials files
.aws/
credentials
config

# Local Terraform cache and lock files
.terraform/
.terraform.lock.hcl

# Logs or temporary files
*.log
*.tmp

# Saved Terraform plan files (binary, may contain sensitive values)
plan-*
bootstrap-dev
bootstrap-prod
bucket-dev
bucket-prod
destroy-dev
destroy-prod
dev-bucket
prod-bucket

# Old state dumps and private keys
*statefile*.json
*.pem
*.key
