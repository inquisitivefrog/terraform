# Terraform state files
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.plan
*plan

# Terraform variables with sensitive data
terraform.tfvars
*.tfvars.json

# AWS credentials files
.aws/
credentials
config

# Local Terraform cache and lock files
.terraform/
.terraform.lock.hcl
# ...except these roots, whose locks are committed for darwin_arm64 + linux_amd64
# (regenerate with: terraform providers lock -platform=darwin_arm64 -platform=linux_amd64)
!/aws/tfstate/bootstrap/*/.terraform.lock.hcl
!/aws/tfstate/environments/*/.terraform.lock.hcl
!/aws/single_instance/environments/*/.terraform.lock.hcl

# Logs or temporary files
*.log
*.tmp

# Saved Terraform plan files (binary, may contain sensitive values)
plan-*
bootstrap-dev
bootstrap-prod
bucket-dev
bucket-prod
destroy-dev
destroy-prod
dev-bucket
prod-bucket
# ecommerce-k8s
state-bucket
stage1
stage2
destroy-stage1
destroy-stage2
destroy-state
aws/ecommerce-k8s/terraform-state/bucket
aws/ecommerce-k8s/terraform-state/destroy-bucket

# Old state dumps and private keys
*statefile*.json
*.pem
*.key
