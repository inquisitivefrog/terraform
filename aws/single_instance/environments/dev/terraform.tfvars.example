# Copy to terraform.tfvars (git-ignored) and fill in.

admin_user_name      = "<IAM user that administers KMS keys>"
availability_zones   = ["us-east-2a", "us-east-2b"]
ec2_keypair          = "<EC2 key pair name in this region>"
eks_version          = "1.36"
env                  = "dev"
instance_type        = "t3.micro"
my_laptop_cidr_block = "<your public IP>/32" # curl -4 ifconfig.me
region               = "us-east-2"
vpc_cidr_block       = "10.1.0.0/16"
