# Copy to terraform.tfvars (git-ignored) and fill in.

employer             = "<organization name, used in tags>"
env                  = "prod"
location             = "westus"
my_laptop_cidr_block = "<your public IP>/32" # curl -4 ifconfig.me
pods_cidr_block      = "10.100.0.0/16"
services_cidr_block  = "10.200.0.0/20"
subscription_id      = "<bluedragon-sre subscription ID>"
vpc_cidr_block       = "10.0.0.0/16"
